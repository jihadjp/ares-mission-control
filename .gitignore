# ==============================================================================
# Ares Mission Control - Git Ignore File
# This file specifies intentionally untracked files that Git should ignore.
# ==============================================================================

# Dependencies & Package Managers
# Local package installation directories for Node.js, pnpm, npm, yarn, etc.
node_modules/
.pnpm-store/

# Build & Compilation Outputs
# Next.js, general Web, and build outputs that should never be committed
.next/
out/
build/
dist/

# TypeScript Incremental Build Information
# Stores type-checking cache to speed up subsequent TypeScript compilations
*.tsbuildinfo

# Logs & Debug Output
# Runtime logs, package manager debug logs, and error outputs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Secrets
# Local configuration and environment files containing sensitive credentials
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDEs & Code Editors
# Editor-specific settings, workspace configurations, and temporary swap files
.idea/
.vscode/
*.swp
*.swo

# Operating System Generated Files
# Hidden system files created by macOS, Windows, and Linux file explorers
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Deployment & Sandbox Internal Files
# Vercel configuration, Snowflake metadata, and v0 runtime/sandbox artifacts
.vercel/
.snowflake/
.v0-trash/
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts

# Local Artifacts & Temporary Files
# Local tool artifacts, test results, and runtime temp files
.artifacts/
